# Clé API Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modèle Gemini pour l'amélioration de texte (défaut: gemini-3.5-flash)
# Nom volontairement différent de GEMINI_MODEL pour éviter toute collision
# avec une variable d'environnement du même nom déjà définie ailleurs.
IDEAS_TEXT_MODEL=gemini-3.5-flash
# Modèle Gemini pour la génération d'illustrations (défaut: gemini-3.1-flash-image)
IDEAS_IMAGE_MODEL=gemini-3.1-flash-image
# Modèle Gemini pour la transcription des idées enregistrées à voix haute
# (défaut: gemini-flash-latest, l'alias qui pointe toujours vers le dernier
# Flash disponible — pas besoin de le mettre à jour à la main).
IDEAS_AUDIO_MODEL=gemini-flash-latest
# Secret pour signer les cookies de session (ex: openssl rand -hex 32)
SESSION_SECRET=change-me

# Base Postgres Neon (obligatoire). Sur Vercel, connecter l'intégration Neon
# au projet la crée et renseigne cette variable automatiquement.
DATABASE_URL=

# Stockage des illustrations générées par l'IA. Sur Vercel, créer un store
# Vercel Blob et le connecter au projet renseigne cette variable
# automatiquement.
BLOB_READ_WRITE_TOKEN=

# Notifications push web (nouveau commentaire/vote, seuil IA atteint, fork,
# dossier de démarrage prêt). Générer une paire avec :
#   npx web-push generate-vapid-keys
# La clé publique doit être dupliquée en NEXT_PUBLIC_* (exposée au client,
# c'est son rôle : elle sert juste à identifier ce serveur, pas un secret).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
