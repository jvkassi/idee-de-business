# Clé API Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modèle Gemini pour l'amélioration de texte (défaut: gemini-3.5-flash)
# Nom volontairement différent de GEMINI_MODEL pour éviter toute collision
# avec une variable d'environnement du même nom déjà définie ailleurs.
IDEAS_TEXT_MODEL=gemini-3.5-flash
# Modèle Gemini pour la génération d'illustrations (défaut: gemini-3.1-flash-image)
IDEAS_IMAGE_MODEL=gemini-3.1-flash-image
# Secret pour signer les cookies de session (ex: openssl rand -hex 32)
SESSION_SECRET=change-me
# Base Turso (obligatoire sur Vercel, optionnel en local)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Chemin du fichier SQLite en local (si pas de Turso)
DATABASE_PATH=./data/ideas.db
